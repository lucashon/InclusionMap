<main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">Painel da Prefeitura</h1>
        <a class="btn btn-outline-light" href="/inclusion/mostrar">Listagem completa</a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-4 bg-dark rounded">
                <div class="small text-uppercase">Cidadãos registrados</div>
                <div class="display-4 text-info">{{count}}</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-4 bg-dark rounded">
                <div class="small text-uppercase">Bairros com ocorrências</div>
                <div class="display-4 text-info">{{bairros.length}}</div>
            </div>
        </div>
    </div>
    <section class="bg-dark rounded p-4">
        <h2 class="h4">Ocorrências por bairro</h2>
        {{#if bairros.length}}
            <ul class="list-group list-group-flush">
                {{#each bairros}}
                    <li class="list-group-item bg-transparent text-white d-flex justify-content-between">
                        <span>{{bairro}}</span><strong>{{count}}</strong>
                    </li>
                {{/each}}
            </ul>
        {{else}}
            <p class="mb-0">Nenhum bairro foi informado nos cadastros.</p>
        {{/if}}
    </section>
</main>