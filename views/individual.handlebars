<section class="container my-5">
  <div class="row g-4 align-items-center">
    <div class="col-md-3 text-center">
      <img class="rounded-circle" src="/assets/leandrinha.webp" alt="Perfil" width="150" height="150">
    </div>
    <div class="col-md-9 text-white">
      <h3>Nome Completo: <strong>{{perfil.nome}}</strong></h3>
      <p>CPF: <strong>{{perfil.cpf}}</strong></p>
      {{#if perfil.dificuldade}}
      <p>Descrito dificuldades: <strong>{{perfil.dificuldade}}</strong></p>
      {{/if}}
      <p>Deficiência: <strong>{{perfil.descricao}}</strong></p>
      <p>Condição: <strong>{{perfil.doenca}}</strong></p>
      <p>Estado: <strong>{{perfil.estado}}</strong></p>
      <p>Cidade: <strong>{{perfil.cidade}}</strong></p>
      <p>Bairro: <strong>{{perfil.bairro}}</strong></p>
      <p>Barreira encontrada: <strong>{{perfil.barreira}}</strong></p>
      {{#if perfil.foto}}<img src="{{perfil.foto}}" alt="Foto enviada por {{perfil.nome}}" width="180">{{/if}}
      <p>E-mail: <strong>{{perfil.email}}</strong></p>

      <div class="mt-3">
        <a class="btn btn-outline-light me-2" href="/inclusion/mostrar">Voltar</a>
        <form class="d-inline" action="/inclusion/delete/{{perfil.id}}" method="post">
          <button class="btn btn-danger" type="submit">Excluir</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script src="/script/mostrar.js"></script>