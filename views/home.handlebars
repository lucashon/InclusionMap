<!-- HERO -->
<section class="hero">
    <div class="hero-inner container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6 hero-left">
                <h1 class="hero-title">Sistema de cadastro online, para uma cidade mais inclusiva</h1>
                <p class="hero-lead">Administração pública facilitada, suprindo a necessidade de pessoas PCDs.</p>
                <div class="hero-actions d-flex flex-wrap align-items-center">
                    <button id="btn" class="btn-cadastro" type="button" aria-label="Cadastre-se agora">Cadastre-se</button>
                    <a class="btn-secundario" href="/inclusion/mostrar" aria-label="Ver cadastrados">Ver cadastrados</a>
                </div>
            </div>

            <div class="col-lg-6 hero-right d-none d-lg-flex justify-content-center">
                <img src="/assets/imagem3.jpg" alt="Inclusão - pessoas diversas em Jaraguá do Sul" class="hero-image img-fluid">
            </div>
        </div>
    </div>
</section>

<!-- QUEM SOMOS -->
<section class="showWe sobre-nos section-alt" id="quem-somos">
    <div class="container px-4">
        <div class="row align-items-center g-5">

            <!-- Coluna de Texto (Esquerda no Desktop, Topo no Mobile) -->
            <div class="col-12 col-lg-6 sobre-nos__content text-center text-lg-start">
                <h2 class="section-title">Quem somos</h2>
                <p class="section-text mb-3">
                    Somos uma plataforma dedicada a dar voz e visibilidade às pessoas com deficiência (PCD) em Jaraguá do Sul. Promovemos a inclusão e a melhoria da qualidade de vida em nossa comunidade.
                </p>
                <p class="section-text mb-4">
                    Nosso objetivo é criar um espaço para PCDs se cadastrarem, compartilharem necessidades e se conectarem a recursos da cidade — facilitando o mapeamento de demandas pela gestão pública.
                </p>
                <ul class="who-list d-inline-block text-start">
                    <li>Mapeamento de acessibilidade local</li>
                    <li>Conexão direta com a prefeitura</li>
                    <li>Portal simples e acessível</li>
                </ul>
            </div>

            <!-- Coluna do Carrossel (Direita no Desktop, Baixo no Mobile) -->
            <div class="col-12 col-lg-6">
                <div class="carousel im-carousel" id="quemSomosCarousel" aria-roledescription="carrossel" aria-label="Imagens do projeto">
                    <div class="carousel__viewport">
                        <div class="carousel__track" id="carouselTrack"></div>
                    </div>
                    <button type="button" class="carousel__btn carousel__btn--prev" id="carouselPrev" aria-label="Imagem anterior">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="carousel__btn carousel__btn--next" id="carouselNext" aria-label="Próxima imagem">
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </button>
                    <div class="carousel__dots" id="carouselDots" role="tablist" aria-label="Indicadores do carrossel"></div>
                </div>
            </div>

        </div>
    </div>
</section>

