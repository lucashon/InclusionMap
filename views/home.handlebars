            <button type="button" class="btn-nav js-open-login" data-user-type="prefeitura" data-redirect="/inclusion/dados">Acesso Prefeitura</button>
            <button type="button" class="btn-nav js-open-login" data-user-type="cidadao" data-redirect="/inclusion/mostrar">Acesso Cidadão</button>
