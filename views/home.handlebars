<!-- MODAL CADASTRO (mantive IDs e action) -->
<div class="box-modal backdrop" id="modal" aria-hidden="true" role="dialog" aria-labelledby="modalCadastroTitle">
    <div class="modal">
        <button type="button" id="close" class="modal-close" aria-label="Fechar modal">Fechar</button>
        <h2 id="modalCadastroTitle">Cadastrar PCD</h2>
        <form action="/inclusion/home" method="post" class="w-100">
            <div><input class="form-control mb-2" type="text" name="nome" placeholder="Digite seu nome completo" required autocomplete="name"></div>
            <div><input class="form-control mb-2" type="email" name="email" placeholder="email" required autocomplete="email"></div>
            <div><input class="form-control mb-2" type="text" name="cpf" placeholder="CPF" autocomplete="off"></div>
            <div><input class="form-control mb-2" type="text" name="descricao" placeholder="Descreva a sua deficiência"></div>
            <div><input class="form-control mb-2" type="text" name="dificuldade" placeholder="Digite suas dificuldades"></div>
            <div><input class="form-control mb-2" type="password" name="senha" placeholder="Crie uma senha (opcional)" autocomplete="new-password"></div>
            <div><button id="submit-cadastro" class="btn-modal-submit" type="submit">Cadastrar</button></div>
        </form>
    </div>
</div>

<!-- MODAL LOGIN -->
<div class="box-modal-login" id="modalLogin" aria-hidden="true" role="dialog" aria-labelledby="modalLoginTitle">
    <div class="modal-login">
        <button type="button" id="closeLogin" class="modal-close" aria-label="Fechar modal de login">Fechar</button>
        <h2 id="modalLoginTitle">Entrar na Conta</h2>
        <p class="modal-login-hint" id="modalLoginHint" hidden></p>
        <p class="modal-login-error" id="loginError" hidden></p>
        <form action="/inclusion/auth/login" method="POST" class="w-100" id="formLogin">
            <input type="hidden" name="userType" id="userType" value="geral">
            <input type="hidden" name="redirectTo" id="redirectTo" value="">
            <div>
                <input class="form-control mb-2" type="email" name="email" id="loginEmail" placeholder="email" required autocomplete="email">
            </div>
            <div>
                <input class="form-control mb-2" type="password" name="senha" id="loginSenha" placeholder="senha" required autocomplete="current-password">
            </div>
            <div>
                <button class="btn-modal-submit" id="submit-entrar" type="submit">Login</button>
            </div>
        </form>
    </div>
</div>
