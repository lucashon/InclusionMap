<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/css/perfil.css?v=3.0">

<div class="dashboard-container">
  
  <!-- Painel Principal do Perfil -->
  <div class="profile-card-modern">
    <div class="avatar-large-container">
      <img src="{{#if perfilCitizen.foto}}{{perfilCitizen.foto}}{{else}}/assets/perfiltodos.png{{/if}}" alt="Foto de perfil" class="avatar-large">
    </div>
    
    <h2 class="user-fullname">{{perfilCitizen.nome}}</h2>
    <p class="user-handle"><i class="fa-regular fa-envelope"></i> {{perfilCitizen.email}}</p>

    <div class="input-field-group">
      <label>CPF</label>
      <input type="text" value="{{perfilCitizen.cpf}}" readonly class="readonly-input">
    </div>

    <div class="input-field-group"><label>Estado</label><input type="text" value="{{perfilCitizen.estado}}" readonly class="readonly-input"></div>
    <div class="input-field-group"><label>Cidade</label><input type="text" value="{{perfilCitizen.cidade}}" readonly class="readonly-input"></div>
    <div class="input-field-group"><label>Bairro</label><input type="text" value="{{perfilCitizen.bairro}}" readonly class="readonly-input"></div>
    <div class="input-field-group"><label>Deficiência ou condição</label><input type="text" value="{{#if perfilCitizen.doenca}}{{perfilCitizen.doenca}}{{else}}{{perfilCitizen.descricao}}{{/if}}" readonly class="readonly-input"></div>

    <div class="card-action-buttons">
      <a href="/inclusion/edit/{{perfilCitizen.id}}" class="btn-primary-gradient">Editar Dados</a>
    </div>
  </div>

  <!-- Painel Secundário / Atividades -->
  <div class="side-widgets-container">
    <div class="widget-card">
      <h3><i class="fa-solid fa-clipboard-list"></i> Dificuldades Relatadas</h3>
      <p class="widget-content">
        {{#if perfilCitizen.barreira}}
          {{perfilCitizen.barreira}}
        {{else if perfilCitizen.dificuldade}}
          {{perfilCitizen.dificuldade}}
        {{else}}
          Sem observações de acessibilidade registadas.
        {{/if}}
      </p>
      <p class="widget-content"><strong>Descrição:</strong> {{perfilCitizen.descricao}}</p>
      <p class="widget-content"><strong>Condição:</strong> {{perfilCitizen.doenca}}</p>
    </div>

    <div class="widget-card status-widget">
      <div class="status-info">
        <span class="status-dot active"></span>
        <span>Estado da Conta: <strong>Ativo</strong></span>
      </div>
      <a href="/inclusion/mostrar" class="btn-link-back"><i class="fa-solid fa-arrow-left"></i> Voltar à Lista</a>
    </div>
  </div>

</div>