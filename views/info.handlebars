<link rel="stylesheet" href="/css/dados.css">

    <main class="page-container">
        <header class="page-header">
            <div>
                <p class="text-uppercase small mb-1">Painel da Prefeitura</p>
                <h1 class="page-title">Listagem completa</h1>
            </div>
            <a href="/inclusion/dados" class="btn-back">Voltar ao painel</a>
        </header>
    <section class="cards-grid">
            {{#each info}}
        <article class="user-card">
            <div class="user-card-accent"></div>
            <div class="user-card-body">
                <div class="user-avatar-container">
                    <img src="{{#if this.foto}}{{this.foto}}{{else}}/assets/perfil.avif{{/if}}" alt="Foto de {{this.nome}}" class="user-avatar">
                </div>
                <div class="user-info">
                    <h2 class="user-name">{{this.nome}}</h2>
                    <div class="user-detail-badge"><i class="fa-solid fa-universal-access"></i><span>{{this.doenca}}</span></div>
                    <div class="user-location">{{this.bairro}}, {{this.cidade}} - {{this.estado}}</div>
                    <p class="user-barrier">{{this.barreira}}</p>
                </div>
                <div class="user-card-actions">
                    <a href="/inclusion/perfil/{{this.id}}" class="btn-card-action btn-solid">Mais informações</a>
                </div>
            </div>
        </article>
            {{else}}
                <p>Nenhum cidadão cadastrado.</p>
            {{/each}}
    </section>
    </main>

