# Example environment variables
# Copy to .env for local development and edit values

NODE_ENV=development
PORT=3000
DB_NAME=projeto
DB_USER=root
# Se usar o MySQL do container "develop-mysql-1", a senha costuma ser "root"
DB_PASS=root
DB_HOST=127.0.0.1
DB_PORT=3306
SESSION_SECRET=algumsegredo
TRUST_PROXY=0
AUTO_SYNC=1
